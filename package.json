  "description": "Børnebogssider lettere at læse: OCR, læsevenlig skrift og farvede stavelser",
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "coverage:unit": "vitest run --coverage",
    "coverage:e2e": "COVERAGE=1 node build.ts && COVERAGE=1 playwright test",
    "coverage": "npm run coverage:unit && npm run coverage:e2e && node coverage.ts && npm run build",
    "lint": "node lint.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/dan": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "hyphen": "^1.14.1",
    "pdf-lib": "1.17.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "woff2-encoder": "2.0.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
